# Supabase project URL and publishable (anon) key.
# Local: run `npx supabase start` and copy API_URL / PUBLISHABLE_KEY from `npx supabase status`.
# Hosted: Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of this site, without a trailing slash. Used for auth email links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a public contact address shown on the Contact page. Leave empty to show the forms only.
NEXT_PUBLIC_CONTACT_EMAIL=
